<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <View
            android:layout_width="88dp"
            android:layout_height="124dp"
            android:background="@drawable/bg_gris_portada" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="150dp"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_gris_barra" />

            <View
                android:layout_width="110dp"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gris_barra" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="64dp"
                android:layout_height="14dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_gris_barra" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
