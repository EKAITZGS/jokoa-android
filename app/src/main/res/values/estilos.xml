<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Botones: 14 dp de radio, 56 dp de alto, pulsado = azul noche + escala 0,98 ===== -->
    <style name="Widget.Jokoa.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/boton_texto</item>
        <item name="android:stateListAnimator">@animator/boton_pulsar</item>
        <item name="backgroundTint">@color/boton_azul_fondo</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/boton_texto</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.Jokoa.Button.Coral">
        <item name="backgroundTint">@color/boton_coral_fondo</item>
    </style>

    <style name="Widget.Jokoa.Button.Compacto">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/boton_coral_fondo</item>
    </style>

    <style name="Widget.Jokoa.Button.CompactoAzul">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Jokoa.Button.Tonal">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/jokoa_azul_noche</item>
        <item name="iconTint">@color/jokoa_azul_noche</item>
        <item name="backgroundTint">@color/jokoa_azul_claro</item>
    </style>

    <style name="Widget.Jokoa.Button.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/jokoa_coral_oscuro</item>
        <item name="android:stateListAnimator">@animator/boton_pulsar</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/jokoa_coral_oscuro</item>
        <item name="strokeWidth">2dp</item>
        <item name="iconTint">@color/jokoa_coral_oscuro</item>
    </style>

    <style name="Widget.Jokoa.Button.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/jokoa_azul</item>
    </style>

    <!-- ===== Tarjetas: 16 dp, borde de 1 dp y sombra de nivel 1 ===== -->
    <style name="Widget.Jokoa.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/jokoa_superficie</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/jokoa_borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== Campos de texto: contorno de 12 dp, borde #6F7F96, enfocado 2 dp azul ===== -->
    <style name="Widget.Jokoa.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/campo_borde</item>
        <item name="boxStrokeErrorColor">@color/jokoa_coral_oscuro</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/campo_borde</item>
        <item name="android:textColorHint">@color/jokoa_texto_2</item>
        <item name="errorTextColor">@color/jokoa_coral_oscuro</item>
        <item name="errorIconTint">@color/jokoa_coral_oscuro</item>
        <item name="endIconTint">@color/jokoa_texto_2</item>
    </style>

    <!-- ===== Barra inferior: píldora azul claro con icono azul noche ===== -->
    <style name="Widget.Jokoa.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/jokoa_superficie</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Jokoa.BottomNav.Indicador</item>
        <item name="itemTextAppearanceActive">@style/TextoNavActivo</item>
        <item name="itemTextAppearanceInactive">@style/TextoNav</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Jokoa.BottomNav.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/jokoa_azul_claro</item>
    </style>

    <style name="TextoNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoNavActivo" parent="TextoNav">
        <item name="android:textColor">@color/jokoa_azul_noche</item>
    </style>

    <!-- ===== Pestañas: azul en negrita e indicador coral de 3 dp ===== -->
    <style name="Widget.Jokoa.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/jokoa_coral</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabSelectedTextColor">@color/jokoa_azul</item>
        <item name="tabTextColor">@color/jokoa_texto_2</item>
        <item name="tabTextAppearance">@style/TextoPestana</item>
        <item name="tabMinWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TextoPestana" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ===== Botón flotante extendido ===== -->
    <style name="Widget.Jokoa.Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/jokoa_coral_oscuro</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="elevation">6dp</item>
        <item name="shapeAppearanceOverlay">@style/FormaPildora</item>
    </style>

    <style name="FormaPortada">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="FormaPildora">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="FormaHoja">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== Diálogos: 16 dp, sombra de nivel 3, fondo oscurecido al 55 %, entrada 220 ms ===== -->
    <style name="ThemeOverlay.Jokoa.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Jokoa</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Jokoa.Titulo</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Jokoa.Button.CompactoAzul</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Jokoa.Button.Texto</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Jokoa.Button.Texto</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/Animacion.Jokoa.Dialogo</item>
    </style>

    <style name="MaterialAlertDialog.Jokoa" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.Jokoa.Dialogo</item>
        <item name="backgroundTint">@color/jokoa_superficie</item>
    </style>

    <style name="ShapeAppearance.Jokoa.Dialogo" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="MaterialAlertDialog.Jokoa.Titulo" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/jokoa_texto</item>
    </style>

    <style name="Animacion.Jokoa.Dialogo" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialogo_entra</item>
        <item name="android:windowExitAnimation">@anim/dialogo_sale</item>
    </style>

    <!-- ===== Texto ===== -->
    <style name="Texto.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/jokoa_texto</item>
    </style>

    <style name="Texto.Chip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
